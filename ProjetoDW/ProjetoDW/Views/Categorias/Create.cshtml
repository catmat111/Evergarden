@model ProjetoDW.Models.Categorias

@{
    ViewData["Title"] = "Create";
}

<link rel="stylesheet" href="~/css/Categorias.css" asp-append-version="true" />
<h1>Criar Categoria</h1>

<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="Nome" class="control-label"></label>
        <input asp-for="Nome" class="form-control" />
        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>

    <div class="form-group form-check">
        <input asp-for="Tipo" class="form-check-input" />
        <label asp-for="Tipo" class="form-check-label"></label>
        <span asp-validation-for="Tipo" class="text-danger"></span>
    </div>

    <div class="form-group-cat">
        <input type="submit" value="Criare" class="btn btn-primary" />
        <a asp-action="Index">Voltar</a>
    </div>
</form>

