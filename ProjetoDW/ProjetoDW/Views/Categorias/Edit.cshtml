@using Microsoft.AspNetCore.Mvc.TagHelpers
@model ProjetoDW.Models.Categorias

@{
    ViewData["Title"] = "Editar Categoria";
}

<link rel="stylesheet" href="~/css/Categorias_Edit.css" asp-append-version="true" />

<h1>Editar Categoria</h1>
<hr />

<div class="row">
    <div class="col-md-6" id="containerContainer">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-3">
                <label asp-for="Tipo" class="form-label d-block">Tipo</label>
                <div class="form-check">
                    <input class="form-check-input" asp-for="Tipo" />
                    <label class="form-check-label" for="Tipo">Exige data de envio</label>
                </div>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Nome" class="form-label"></label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary" style="    padding: 10px 18px; ">💾 Guardar</button>
                <a asp-action="Index" class="btn btn-secondary" style="padding: 9.5px 18px; ">❌ Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
