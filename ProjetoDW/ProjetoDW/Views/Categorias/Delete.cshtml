@model ProjetoDW.Models.Categorias

@{
    ViewData["Title"] = "Eliminar Categoria";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/Categorias_Delete.css" asp-append-version="true" />

<div class="delete-container">
    <h1 class="title">Eliminar Categoria</h1>

    <div class="warning-text">
        ⚠️ Tens a certeza que queres apagar esta categoria?
    </div>

    <hr />

    <dl class="row">
        <dt class="col-sm-3">Tipo</dt>
        <dd class="col-sm-9">
            @(Model.Tipo ? "Com data de envio obrigatória" : "Sem data de envio")
        </dd>

        <dt class="col-sm-3">Nome</dt>
        <dd class="col-sm-9">@Model.Nome</dd>
    </dl>

    <form asp-action="Delete" class="text-center mt-4">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">🗑️ Eliminar</button>
        <a asp-action="Index" class="btn btn-secondary ml-3">❌ Cancelar</a>
    </form>
</div>
