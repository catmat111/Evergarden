@model ProjetoDW.Models.Categorias

@{
    ViewData["Title"] = "Detalhes da Categoria";
}
<link rel="stylesheet" href="~/css/Categorias_Details.css" asp-append-version="true" />

<div class="details-container">
    <h1 class="title">Detalhes da Categoria</h1>
    <hr />

    <div class="details-box">
        <dl class="row">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Nome)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Nome)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Tipo)
            </dt>
            <dd class="col-sm-9">
                @(Model.Tipo ? "Exige data de envio" : "Não exige data")
            </dd>
        </dl>
    </div>

    <div class="mt-4" style="text-align: center">
        <a asp-action="Index" class="btn btn-secondary ml-2">↩️ Voltar à Lista</a>
    </div>
</div>
