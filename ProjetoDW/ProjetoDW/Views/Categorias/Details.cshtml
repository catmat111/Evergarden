@model ProjetoDW.Models.Categorias

@{
    ViewData["Title"] = "Details";
}
<link rel="stylesheet" href="~/css/Categorias.css" asp-append-version="true" />
<div>
    <h4> Detalhes da categoria @Html.DisplayFor(model => model.Nome) </h4> 
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Tipo)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Tipo)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Nome)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Nome)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Editar</a> |
    <a asp-action="Delete" asp-route-id="@Model?.Id">Eliminar</a> |
    <a asp-action="Index">Voltar</a>
</div>