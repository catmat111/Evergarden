@using Microsoft.AspNetCore.Mvc.TagHelpers
@model ProjetoDW.Models.Utilizadores

@{
    ViewData["Title"] = "Criar Destinatário";
}
<link rel="stylesheet" href="~/css/Utilizadores_Criar.css" asp-append-version="true" />

<div class="edit-container">
    <h1 class="title">Criar Destinatário</h1>

    <hr />

    <div class="form-wrapper">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Nome"></label>
                <input asp-for="Nome" class="form-control" placeholder="Nome completo" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" placeholder="Email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Telemovel"></label>
                <input asp-for="Telemovel" class="form-control" placeholder="Telemóvel" />
                <span asp-validation-for="Telemovel" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Imagem">Fotografia</label>
                <input type="file" asp-for="Imagem" class="form-control" accept="image/*" onchange="previewImagem(this)" />
                <span asp-validation-for="Imagem" class="text-danger"></span>
                <div class="imagem-preview mt-2">
                    <img id="preview" src="../recursos/default.png" alt="Pré-visualização" class="img-thumbnail" />
                </div>
            </div>

            <div class="form-group">
                <label asp-for="DataNascimento"></label>
                <input asp-for="DataNascimento" type="date" class="form-control"
                       max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="DataNascimento" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label for="password">Palavra-passe</label>
                <input name="password" type="password" class="form-control" placeholder="Palavra-passe" />
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">✏️ Criar</button>
                <a asp-action="Index" class="btn btn-secondary ml-2">❌ Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        /**
         * Exibe uma pré-visualização da imagem selecionada num campo de input de ficheiro.
         * Esta função deve ser chamada no evento 'onchange' do input.
         * Exemplo de uso no HTML: <input type="file" onchange="previewImagem(this)" />
         * param {HTMLInputElement} input - O elemento input do tipo 'file' que acionou o evento.
         */
        function previewImagem(input) {
            // Obtém o elemento <img> onde a pré-visualização será exibida.
            const preview = document.getElementById('preview');

            // Verifica se um ficheiro foi selecionado.
            if (input.files && input.files[0]) {
                // Cria um objeto FileReader para ler o conteúdo do ficheiro.
                const reader = new FileReader();

                // Define o que acontece quando a leitura do ficheiro estiver concluída.
                reader.onload = function (e) {
                    // Atribui o resultado da leitura (um URL de dados) ao 'src' da imagem.
                    preview.src = e.target.result;
                    // Torna a imagem de pré-visualização visível.
                    preview.style.display = "block";
                };

                // Inicia a leitura do ficheiro como um Data URL.
                reader.readAsDataURL(input.files[0]);
            } else {
                // Se nenhum ficheiro for selecionado, esconde a pré-visualização.
                preview.src = "#";
                preview.style.display = "none";
            }
}

        /**
         * Ouve o evento de carregamento do conteúdo da página.
         */
        document.addEventListener('DOMContentLoaded', function () {
            // Procura por qualquer campo de input do tipo 'date'.
            const dateInput = document.querySelector('input[type="date"]');

            // Se um campo de data for encontrado, adiciona um 'ouvinte' de evento.
            if (dateInput) {
                // Impede que o utilizador digite manualmente no campo de data,
                // forçando o uso do seletor de data do browser.
                dateInput.addEventListener('keydown', function (e) {
                    e.preventDefault();
                });
            }
});
    </script>
}
