@model ProjetoDW.Models.Utilizadores

@{
    ViewData["Title"] = "Create";
}
<link rel="stylesheet" href="~/css/Utilizadores_Criar.css" asp-append-version="true" />

<form asp-action="Create" method="post" enctype="multipart/form-data">

    <div style="border: 2px solid #f4d35e; border-radius: 20px; padding-left: 10px; margin-bottom: 5px; color: #d4af37aa; font-weight: bold"; background-color: #fffbea;>
        <h2 style="font-weight: bold">Criar Utilizador Destinatário</h2>
    </div>
    <div class="form-group">
        <label asp-for="Nome"></label>
        <input asp-for="Nome" class="form-control"/>
        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Telemovel" class="control-label"></label>
        <div class="input-group">
            <input asp-for="Telemovel" class="form-control" />
        </div>
        <span asp-validation-for="Telemovel" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Imagem"></label>
        <input asp-for="Imagem" type="file" class="form-control" />
        <span asp-validation-for="Imagem" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="DataNascimento"></label>
        <input asp-for="DataNascimento" class="form-control" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" min="1900-01-01"/>
        <span asp-validation-for="DataNascimento" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Password</label>
        <input name="password" type="password" class="form-control" />
    </div>

    <button style="margin-top: 10px" type="submit" class="btn btn-primary">Criar Destinatário</button>
</form>


<script>
    document.addEventListener('DOMContentLoaded', function () {
        const dateInput = document.querySelector('input[type="date"]');
        if (dateInput) {
            dateInput.addEventListener('keydown', function (e) {
                e.preventDefault();
            });
        }
    });
</script>
