@using Microsoft.AspNetCore.Mvc.TagHelpers
@model ProjetoDW.Models.Utilizadores

@{
    ViewData["Title"] = "Detalhes do Utilizador";
}

<link rel="stylesheet" href="~/css/Utilizadores_Details.css" asp-append-version="true" />

<div class="perfil-container">
    <h2 class="perfil-title">Detalhes do Utilizador</h2>

    <div class="perfil-card">
        <div class="perfil-imagem">
            <img src="/recursos/@Model.ImagemPath" alt="Foto de perfil" />
        </div>
        <div class="perfil-detalhes">
            <p><strong>Nome:</strong> @Model.Nome</p>
            <p><strong>Telemóvel:</strong> @Model.Telemovel</p>
            <p><strong>Email:</strong> @Model.Email</p>
            <p><strong>Data de Nascimento:</strong> @Model.DataNascimento</p>
        </div>
    </div>

    <div class="perfil-voltar">
        <a asp-action="Index" class="btn-voltar">↩️ Voltar à Lista</a>
    </div>
</div>