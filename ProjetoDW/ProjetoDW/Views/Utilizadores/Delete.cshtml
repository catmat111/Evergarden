@model ProjetoDW.Models.Utilizadores

@{
    ViewData["Title"] = "Eliminar Conta";
}
<link rel="stylesheet" href="~/css/Utilizadores_Delete.css" asp-append-version="true" />

<div class="delete-container">
    <h2 class="title">Eliminar Conta</h2>
    <p class="warning-text">⚠️ Tens a certeza que queres prosseguir com a eliminação da tua conta?</p>

    <div class="user-details">
        <h4>Informações do Utilizador</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Nome)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Nome)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ImagemPath)</dt>
            <dd class="col-sm-9"><img src="~/recursos/@Model.ImagemPath" style="width: 100px;height: 100px;border-radius: 50%;border: 4px solid #bfa145;display: inline-block"/></dd>
            
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Telemovel)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Telemovel)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Email)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Email)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DataNascimento)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DataNascimento)</dd>
        </dl>
    </div>

    <form asp-action="Delete" method="post" class="mt-4">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">🗑️ Eliminar Conta</button>
        @if (Model.RemetenteId == null)
        {
            <a asp-action="Perfil" class="btn btn-secondary ms-2">❌ Cancelar</a>
        }
        else
        {
            <a asp-action="Index" class="btn btn-secondary ms-2">❌ Cancelar</a>
        }
    </form>
</div>
