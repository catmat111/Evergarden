@model List<ProjetoDW.Models.Utilizadores>

<link rel="stylesheet" href="~/css/Utilizadores_Index.css" asp-append-version="true" />

<div class="utilizadores-container">
    <h2 class="utilizadores-title">Meus Destinatários</h2>

    <form asp-action="Index" method="get" class="utilizadores-search">
        <input type="text" name="searchString" class="form-control" placeholder="Pesquise pelo nome do seu Destinatário..." />
        <button type="submit">
            <img class="lupa" src="/recursos/imagens_geral/lupa.png" alt="Pesquisar" />
        </button>
    </form>

    <div class="utilizadores-lista">
        @foreach (var user in Model)
        {
            <div class="utilizador-linha">
                <div class="utilizador-imagem">
                    <img src="/recursos/@user.ImagemPath" alt="@user.Nome"/>
                </div>
                <div class="utilizador-info">
                    <h3><strong>@user.Nome</strong></h3>
                    <p><span class="rotulo">Email:</span> @user.Email</p>
                    <p><span class="rotulo">Telemóvel:</span> @user.Telemovel</p>
                    <p><span class="rotulo">Data de Nascimento:</span> @user.DataNascimento</p>
                </div>
                <div class="utilizador-botoes">
                    <a asp-action="Details" asp-route-id="@user.Id">Detalhes</a>
                    <a asp-action="Edit" asp-route-id="@user.Id" class="editar">Editar</a>
                    <a asp-action="Delete" asp-route-id="@user.Id" class="apagar">Apagar</a>
                </div>
            </div>
        }
    </div>
</div>