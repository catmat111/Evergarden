@model ProjetoDW.Models.Utilizadores

@{
    ViewData["Title"] = "Editar Utilizador";
}

<link rel="stylesheet" href="~/css/Utilizadores_Edit.css" asp-append-version="true" />

<div class="edit-container">
    <h1 class="title">
        @(Model.RemetenteId == null ? "Editar Remetente" : "Editar Destinatário")
    </h1>

    <hr />

    <div class="form-wrapper">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label asp-for="Nome"></label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Imagem"></label>
                <input type="file" asp-for="Imagem" class="form-control" accept="image/*" onchange="previewImagem(this)" />
                <span asp-validation-for="Imagem" class="text-danger"></span>
                <div class="imagem-preview mt-2">
                    <img id="preview" src="~/@Model.ImagemPath" alt="Imagem atual" class="img-thumbnail" />
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Telemovel"></label>
                <input asp-for="Telemovel" class="form-control" />
                <span asp-validation-for="Telemovel" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DataNascimento"></label>
                <input asp-for="DataNascimento" class="form-control" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" min="1900-01-01" />
                <span asp-validation-for="DataNascimento" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Email</label>
                <input type="text" value="@Model.Email" class="form-control" readonly />
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Salvar</button>
                <a asp-action="Index" class="btn btn-secondary ml-2">Cancelar</a>
            </div>
        </form>
    </div>
</div>

<script>
    function previewImagem(input) {
        const preview = document.getElementById('preview');
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function (e) {
                preview.src = e.target.result;
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    // Prevenir escrita no date input
    document.addEventListener('DOMContentLoaded', function () {
        const dateInput = document.querySelector('input[type="date"]');
        if (dateInput) {
            dateInput.addEventListener('keydown', function (e) {
                e.preventDefault();
            });
        }
    });
</script>
