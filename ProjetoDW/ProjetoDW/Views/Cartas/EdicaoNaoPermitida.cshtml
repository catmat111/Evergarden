@{
    ViewBag.Title = "Edição Não Permitida";
    Layout = "_Layout";
}

<div style="text-align: center; padding: 60px 20px;">
    <h2 style="color: #dc3545; font-weight: bold; font-size: 2rem; margin-bottom: 1rem;">
        A carta já foi enviada!
    </h2>
    <h3 style="color: #6c757d; font-size: 1.25rem;">
        Já não pode editá-la.
    </h3>

    <a href="javascript:history.back()" 
       style="display: inline-block; margin-top: 30px; padding: 10px 20px; font-weight: 600; 
              background-color: #0d6efd; color: white; text-decoration: none; border-radius: 6px; 
              box-shadow: 0 4px 10px rgba(0,0,0,0.1); transition: background-color 0.2s ease;">
        Voltar atrás
    </a>
</div>