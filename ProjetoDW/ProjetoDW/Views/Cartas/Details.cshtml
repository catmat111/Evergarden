@model ProjetoDW.Models.Cartas

@{
    ViewData["Title"] = "Detalhes da Carta";
}

<link rel="stylesheet" href="~/css/Cartas_Details.css" asp-append-version="true" />

<div class="carta-container">
    <h2 class="carta-title">Detalhes da Carta</h2>

    <div class="carta-card">
        <div class="carta-detalhes">
            <p><strong>Título:</strong> @Model.Titulo</p>
            <p><strong>Descrição:</strong> @Model.Descricao</p>
            <p><strong>Data de Envio:</strong> @(Model.DataEnvio?.ToString("dd/MM/yyyy") ?? "Não definida")</p>
            <p><strong>Data de Criação:</strong> @Model.DataCriacao.ToString("dd/MM/yyyy")</p>
            <p><strong>Remetente:</strong> @Model.UtilizadorRemetente?.Nome</p>
            <p><strong>Destinatário:</strong> @Model.UtilizadorDestinatario?.Nome</p>
        </div>
    </div>

    <div class="carta-acoes">
        <a asp-action="Index" class="btn-voltar">↩️ Voltar à Lista</a>
    </div>
</div>
