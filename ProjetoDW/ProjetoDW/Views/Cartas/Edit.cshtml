@model ProjetoDW.Models.Cartas

@{
    ViewData["Title"] = "Editar Carta";
    var exigeData = ViewBag.ExigeData;
}

<link rel="stylesheet" href="~/css/Cartas_Edit.css" asp-append-version="true" />

<div class="edit-container">
    <h2 class="title">Editar Carta</h2>

    <form asp-action="Edit" method="post" id="formCarta">
        <input type="hidden" asp-for="Id" />

        <div class="form-group">
            <label asp-for="Titulo" class="control-label"></label>
            <input asp-for="Titulo" class="form-control" />
            <span asp-validation-for="Titulo" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Descricao" class="control-label"></label>
            <textarea asp-for="Descricao" class="form-control" rows="5"></textarea>
            <span asp-validation-for="Descricao" class="text-danger"></span>
        </div>

        <div class="form-group" id="dataEnvioContainer" style="display:@(exigeData ? "block" : "none")">
            <label asp-for="DataEnvio" class="control-label"></label>
            <input asp-for="DataEnvio" class="form-control" type="date" id="DataEnvio" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
            <span asp-validation-for="DataEnvio" class="text-danger" id="dataEnvioErro" style="display:none;"></span>
        </div>

        <div class="form-group">
            <label><strong>Categorias</strong> <span class="text-danger">*</span></label>
            <div class="categorias-lista">
                @foreach (var categoria in (List<ProjetoDW.Models.Categorias>)ViewBag.Categorias)
                {
                    <div class="form-check form-check-inline categoria-item">
                        <input type="checkbox"
                               class="form-check-input categoria-checkbox"
                               name="categoriasSelecionadas"
                               value="@categoria.Id"
                               data-tipo="@categoria.Tipo.ToString().ToLower()"
                               @(Model.Categorias.Any(c => c.Id == categoria.Id) ? "checked" : "") />
                        <label class="form-check-label">@categoria.Nome</label>
                    </div>
                }
            </div>
            <span id="categoriasErro" class="text-danger" style="display:none;">Por favor selecione pelo menos uma categoria.</span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i> Guardar
            </button>
            <a asp-action="Index" class="btn btn-secondary ml-2">
                <i class="fas fa-times"></i> Cancelar
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        function atualizarVisibilidadeDataEnvio() {
            const checkboxes = document.querySelectorAll('.categoria-checkbox');
            let mostrarData = false;

            checkboxes.forEach(cb => {
                if (cb.checked && cb.dataset.tipo === "true") {
                    mostrarData = true;
                }
            });

            const dataContainer = document.getElementById("dataEnvioContainer");
            const dataInput = document.getElementById("DataEnvio");
            const dataErro = document.getElementById("dataEnvioErro");

            if (mostrarData) {
                dataContainer.style.display = "block";
                dataInput.required = true;
                dataErro.style.display = "none";
            } else {
                dataContainer.style.display = "none";
                dataInput.required = false;
                dataInput.value = "";
                dataErro.style.display = "none";
            }
        }

        document.addEventListener("DOMContentLoaded", () => {
            atualizarVisibilidadeDataEnvio();

            const dataInput = document.getElementById("DataEnvio");
            dataInput.addEventListener("keydown", e => e.preventDefault());

            document.querySelectorAll('.categoria-checkbox').forEach(cb => {
                cb.addEventListener("change", atualizarVisibilidadeDataEnvio);
            });

            document.getElementById('formCarta').addEventListener('submit', function (e) {
                const checkboxes = document.querySelectorAll('.categoria-checkbox:checked');
                const erroCategorias = document.getElementById('categoriasErro');
                const dataErro = document.getElementById("dataEnvioErro");

                if (checkboxes.length === 0) {
                    erroCategorias.style.display = "block";
                    e.preventDefault();
                    return;
                } else {
                    erroCategorias.style.display = "none";
                }

                if (dataInput.required) {
                    if (!dataInput.value) {
                        dataErro.textContent = "Por favor selecione uma data.";
                        dataErro.style.display = "block";
                        e.preventDefault();
                        return;
                    }

                    const hoje = new Date();
                    hoje.setHours(0, 0, 0, 0);
                    const dataSelecionada = new Date(dataInput.value);

                    if (dataSelecionada < hoje) {
                        dataErro.textContent = "A data deve ser hoje ou uma data futura.";
                        dataErro.style.display = "block";
                        e.preventDefault();
                        return;
                    }

                    dataErro.style.display = "none";
                }
            });
        });
    </script>
}
