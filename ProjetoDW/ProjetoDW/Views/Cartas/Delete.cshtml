@model ProjetoDW.Models.Cartas

@{
    ViewData["Title"] = "Eliminar Carta";
    Layout = "_Layout";
}
<link rel="stylesheet" href="~/css/Cartas_Delete.css" asp-append-version="true" />

<div class="delete-container">
    <h1 class="title">Eliminar Carta</h1>

    <div class="warning-text">
        Tem a certeza que deseja eliminar esta carta?
    </div>

    <hr />

    <dl class="row">
        <dt class="col-sm-3">Título</dt>
        <dd class="col-sm-9">@Model.Titulo</dd>

        <dt class="col-sm-3">Descrição</dt>
        <dd class="col-sm-9">@Model.Descricao</dd>

        <dt class="col-sm-3">Data de Envio</dt>
        <dd class="col-sm-9">
            @if (Model.DataEnvio != null)
            {
                @Model.DataEnvio?.ToString("dd/MM/yyyy")
            }
            else
            {
                <span>-</span>
            }
        </dd>

        <dt class="col-sm-3">Data de Criação</dt>
        <dd class="col-sm-9">@Model.DataCriacao</dd>

        <dt class="col-sm-3">Remetente</dt>
        <dd class="col-sm-9">@Model.UtilizadorRemetente?.Nome</dd>

        <dt class="col-sm-3">Destinatário</dt>
        <dd class="col-sm-9">@Model.UtilizadorDestinatario?.Nome</dd>
    </dl>

    <form asp-action="Delete" class="text-center mt-4">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">🗑️ Eliminar</button>
        <a asp-action="Index" class="btn btn-secondary ml-3">Cancelar</a>
    </form>
</div>
