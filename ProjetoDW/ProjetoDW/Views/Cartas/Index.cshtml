@using Azure.Core
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model IEnumerable<ProjetoDW.Models.Cartas>

@{
    var isRemetente = User.IsInRole("Remetente");
    var isDestinatario = User.IsInRole("Destinatario");
    var query = ViewContext.HttpContext.Request.Query;
    var inputName = isRemetente ? "searchDestinatario" : "searchRemetente";
    var inputPlaceholder = isRemetente ? "Pesquise pelo nome do Destinatário" : "Pesquise pelo nome do Remetente";

    string currentSearch = isRemetente ? (query.ContainsKey("searchDestinatario") ? query["searchDestinatario"].ToString() : "") 
        : (query.ContainsKey("searchRemetente") ? query["searchRemetente"].ToString() : "");
}




<link rel="stylesheet" href="~/css/Cartas_Index.css" asp-append-version="true" />
<div class="row">
    <div class="coluna-esquerda">
        <div class="pesquisa_nome">
            <h1>Cartas</h1>

            <form asp-action="Index" method="get" class="mb-3">
                <div style="display:flex; align-items:center; gap: 10px;">
                    <button type="submit" style="border: none; background: none; padding: 0;">
                        <img src="/recursos/imagens_geral/lupa.png"
                             style="width: 40px; height: 40px; cursor:pointer;" />
                    </button>

                    <input type="text" name="@inputName"
                           value="@currentSearch"
                           placeholder="@inputPlaceholder"
                           class="form-control" style="width: 50%" />
                </div>
            </form>
        </div>



        <table class="table table-hover">

            @if (isRemetente)
            {
                <thead>
                <tr>
                    <th style="min-width: 150px">
                        @Html.DisplayNameFor(model => model.Titulo)
                    </th>
                    <th style="min-width: 100px">
                        @Html.DisplayNameFor(model => model.DataEnvio)
                    </th>
                    <th style="min-width: 150px">
                        @Html.DisplayNameFor(model => model.UtilizadorDestinatarioFk)
                    </th>
                    <th style="min-width: 150px">
                        @Html.DisplayNameFor(model => model.Categorias)
                    </th>
                </tr>
                </thead>
                <tbody>
                <div class="coluna-direita">
                    <h2>To-Do List</h2>


                    <ul>
                        @if (ViewBag.Tarefas != null)
                        {
                            foreach (var tarefa in ViewBag.Tarefas as List<ProjetoDW.Models.Tarefa>)
                            {
                                <li>
                                    <form asp-controller="Tarefa" asp-action="Toggle" method="post" style="display:inline;">
                                        <input type="hidden" name="id" value="@tarefa.Id"/>
                                        <input type="checkbox" onchange="this.form.submit()" @(tarefa.Terminado ? "checked" : "")/>
                                        @tarefa.Nome
                                    </form>
                                    <form asp-controller="Tarefa" asp-action="Delete" method="post" style="display:inline;">
                                        <input type="hidden" name="id" value="@tarefa.Id"/>
                                        <button type="submit" class="btn btn-sm btn-danger">X</button>
                                    </form>
                                </li>
                            }
                        }
                    </ul>

                </div>
                <form asp-controller="Tarefa" asp-action="Create" method="post">
                    <input type="text" name="Nome" placeholder="Nova tarefa" class="form-control" required/>
                    <button type="submit" class="btn btn-success mt-2" style="margin-bottom: 5px">Adicionar</button>
                </form>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Titulo)
                        </td>

                        <td>
                            @if (item.DataEnvio == null)
                            {
                                @:Já foi enviada!
                            }
                            else
                            {
                                @Html.DisplayFor(modelItem => item.DataEnvio)
                            }
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.UtilizadorDestinatario.Nome)
                        </td>
                        <td>
                            @if (item.Categorias != null && item.Categorias.Any())
                            {
                                foreach (var categoria in item.Categorias)
                                {
                                    <span class="badge bg-info me-1">@categoria.Nome</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">Sem categorias</span>
                            }
                        </td>
                        <td style="min-width: 250px">
                            <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                            <a asp-action="Details" asp-route-id="@item.Id">Detalhes</a> |
                            <a asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
                        </td>
                    </tr>
                }
                </tbody>
            }
            else if (isDestinatario)
            {
                
                <tbody>
                @foreach (var item in Model)
                {
                    <div class="carta-fundo">
                        <div class="carta-conteudo">
                        <h4>@item.Titulo</h4>
                        <p><strong>Data de Envio:</strong> @(item.DataEnvio?.ToShortDateString() ?? "Já foi enviada!")</p>
                        <p><strong>@(isRemetente ? "Destinatário" : "Remetente"):</strong> @(isRemetente ? item.UtilizadorDestinatario?.Nome : item.UtilizadorRemetente?.Nome)</p>
                        
                        <p><strong>Categorias:</strong>
                            @if (item.Categorias != null && item.Categorias.Any())
                            {
                                foreach (var categoria in item.Categorias)
                                {
                                    <span class="badge bg-info me-1">@categoria.Nome</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">Sem categorias</span>
                            }
                        </p>
                            <a asp-action="Details" asp-route-id="@item.Id">Ver a carta</a> 
                        </div>
                    </div>

                }
                </tbody>
            }
        </table>
    </div>
    <div class="coluna-direita">
        <div id="calendar"></div>
    </div>

</div>



<script>
    document.addEventListener("DOMContentLoaded", function () {
        const form = document.getElementById("formPesquisa");
        const input = document.getElementById("inputPesquisa");

        // Verifica a role do utilizador usando atributos da página
        const isRemetente = @User.IsInRole("Remetente").ToString().ToLower(); // "true" ou "false"
        const isDestinatario = @User.IsInRole("Destinatario").ToString().ToLower();

        if (isRemetente === "true") {
            input.name = "searchDestinatario";
            input.placeholder = "Pesquise pelo nome do Destinatário...";
        } else if (isDestinatario === "true") {
            input.name = "searchRemetente";
            input.placeholder = "Pesquise pelo nome do Remetente...";
        }
    });
    
    const datasComCartas = @Html.Raw(Json.Serialize(ViewBag.DatasComCartas ?? new List<string>()));

    function adicionarTarefa() {
        const input = document.getElementById("novaTarefa");
        const nome = input.value.trim();

        if (nome === "") return;

        fetch('/Tarefa/Adicionar', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('[name="__RequestVerificationToken"]').value
            },
            body: JSON.stringify({ nome })
        })
            .then(response => response.json())
            .then(data => {
                if (data.sucesso) {
                    const lista = document.getElementById("listaTarefas");
                    const item = document.createElement("li");
                    item.className = "list-group-item d-flex justify-content-between align-items-center";
                    item.innerHTML = `
                    <span>${data.tarefa.nome}</span>
                    <input type="checkbox" disabled />
                `;
                    lista.appendChild(item);
                    input.value = "";
                }
            });
    }

    document.addEventListener('DOMContentLoaded', function () {
        const calendarEl = document.getElementById('calendar');
        let currentMonth = new Date().getMonth();
        let currentYear = new Date().getFullYear();

        function renderCalendar(month, year) {
            const monthNames = ["Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho", "Julho",
                "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro"];

            const firstDay = new Date(year, month, 1).getDay();
            const daysInMonth = new Date(year, month + 1, 0).getDate();

            let calendarHTML = `<div class="month">
                <ul>
                    <li class="prev" onclick="changeMonth(-1)">&#10094;</li>
                    <li class="next" onclick="changeMonth(1)">&#10095;</li>
                    <li>${monthNames[month]}<br><span style="font-size:18px">${year}</span></li>
                </ul>
            </div>
            <ul class="weekdays">
                <li>Seg</li><li>Ter</li><li>Qua</li><li>Qui</li><li>Sex</li><li>Sáb</li><li>Dom</li>
            </ul>
            <ul class="days">`;

            let day = 1;
            const adjustedFirstDay = firstDay === 0 ? 6 : firstDay - 1;

            for (let i = 0; i < 6; i++) {
                for (let j = 0; j < 7; j++) {
                    if ((i === 0 && j < adjustedFirstDay) || day > daysInMonth) {
                        calendarHTML += `<li></li>`;
                    } else {
                        const dateString = `${year}-${(month + 1).toString().padStart(2, '0')}-${day.toString().padStart(2, '0')}`;
                        const temCarta = datasComCartas.includes(dateString) ? 'tem-carta' : '';
                        calendarHTML += `<li class="${temCarta}" onclick="filtrarPorData('${dateString}')">${day}</li>`;
                        day++;
                    }
                }
            }
            
            calendarHTML += `</ul>`;
            calendarEl.innerHTML = calendarHTML;
        }

        window.changeMonth = function (delta) {
            currentMonth += delta;
            if (currentMonth < 0) {
                currentMonth = 11;
                currentYear--;
            } else if (currentMonth > 11) {
                currentMonth = 0;
                currentYear++;
            }
            renderCalendar(currentMonth, currentYear);
        };

        window.filtrarPorData = function (data) {
            const form = document.createElement("form");
            form.method = "get";
            form.action = "/Cartas/Index";

            const input = document.createElement("input");
            input.type = "hidden";
            input.name = "dataSelecionada";
            input.value = data;

            form.appendChild(input);
            document.body.appendChild(form);
            form.submit();
        };

        renderCalendar(currentMonth, currentYear);
    });

</script>


