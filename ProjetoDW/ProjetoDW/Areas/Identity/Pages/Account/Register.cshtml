@page
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model RegisterModel

@{
    ViewData["Title"] = "Criar Conta Remetente";
}
<link rel="stylesheet" href="~/css/Register.css" />

<h1 class="mb-4">Criar Conta Remetente</h1>

<hr class="mb-4"/>

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" enctype="multipart/form-data" class="shadow-sm p-4 rounded bg-light">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Input.Utilizadores.Email" class="form-label"></label>
                <input asp-for="Input.Utilizadores.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com"/>
                <span asp-validation-for="Input.Utilizadores.Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label"></label>
                <input type="password" asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Palavra-passe"/>
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Utilizadores.Nome" class="form-label"></label>
                <input asp-for="Input.Utilizadores.Nome" class="form-control" aria-required="true" placeholder="Nome"/>
                <span asp-validation-for="Input.Utilizadores.Nome" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Utilizadores.Telemovel" class="form-label"></label>
                <input asp-for="Input.Utilizadores.Telemovel" class="form-control" placeholder="Telemóvel"/>
                <span asp-validation-for="Input.Utilizadores.Telemovel" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Utilizadores.DataNascimento" class="form-label"></label>
                <input asp-for="Input.Utilizadores.DataNascimento" class="form-control" type="date" placeholder="Data de Nascimento" max="@DateTime.Today.ToString("yyyy-MM-dd")"/>
                <span asp-validation-for="Input.Utilizadores.DataNascimento" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Input.Utilizadores.Imagem" class="form-label"></label>
                <input asp-for="Input.Utilizadores.Imagem" class="form-control" type="file" accept="image/*"/>
                <span asp-validation-for="Input.Utilizadores.Imagem" class="text-danger small"></span>
            </div>

            <div class="d-grid">
                <button type="submit" class="btn btn-primary">Criar Conta</button>
            </div>
        </form>
        
    </div>
</div>
